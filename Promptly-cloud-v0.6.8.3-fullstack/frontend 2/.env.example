# ============================================
# Promptly Frontend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# For Vercel deployment, set these in the Vercel dashboard

# --------------------------------------------
# Backend API Configuration
# --------------------------------------------

# Backend API base URL (REQUIRED)
# 
# Local development (if backend runs on port 8080):
#   VITE_API_BASE=http://localhost:8080
#
# Production (Render backend):
#   VITE_API_BASE=https://your-app.onrender.com
#
# IMPORTANT: Do NOT include a trailing slash
VITE_API_BASE=http://localhost:8080

# --------------------------------------------
# Notes for Deployment
# --------------------------------------------
#
# Vercel:
#   Add VITE_API_BASE to your Environment Variables in project settings
#   Value should be your Render backend URL (without trailing slash)
#
# Local development:
#   Copy this file to .env.local
#   Update VITE_API_BASE to match your backend port
#
