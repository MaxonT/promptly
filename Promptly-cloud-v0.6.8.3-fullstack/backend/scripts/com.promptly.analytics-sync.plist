<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ============================================
  Promptly Analytics 自动数据同步
  ============================================
  功能: 每 3 小时从本地 SQLite 同步数据到云端
  
  安装步骤:
  1. 编辑此文件，替换 USER_HOME 为实际路径
  2. 复制到 ~/Library/LaunchAgents/
  3. 加载: launchctl load ~/Library/LaunchAgents/com.promptly.analytics-sync.plist
  
  管理命令:
  - 停止: launchctl unload ~/Library/LaunchAgents/com.promptly.analytics-sync.plist
  - 查看状态: launchctl list | grep promptly
  - 手动触发: launchctl start com.promptly.analytics-sync
  - 查看日志: tail -f ~/Desktop/Github/Promptly-v0.6-CloudTest/Promptly-cloud-v0.6.8.3-fullstack/logs/auto-sync.log
  ============================================
-->
<plist version="1.0">
<dict>
    <!-- 任务标识符 -->
    <key>Label</key>
    <string>com.promptly.analytics-sync</string>
    
    <!-- 执行的脚本 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/yangming/Desktop/Github/Promptly-v0.6-CloudTest/Promptly-cloud-v0.6.8.3-fullstack/backend/scripts/auto-sync.sh</string>
    </array>
    
    <!-- 每 3 小时执行一次 (10800 秒) -->
    <key>StartInterval</key>
    <integer>10800</integer>
    
    <!-- 启动时也执行一次 -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- 环境变量 -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/yangming/.nvm/versions/node/v22.14.0/bin</string>
        <key>HOME</key>
        <string>/Users/yangming</string>
    </dict>
    
    <!-- 工作目录 -->
    <key>WorkingDirectory</key>
    <string>/Users/yangming/Desktop/Github/Promptly-v0.6-CloudTest/Promptly-cloud-v0.6.8.3-fullstack/backend</string>
    
    <!-- 标准输出日志 -->
    <key>StandardOutPath</key>
    <string>/Users/yangming/Desktop/Github/Promptly-v0.6-CloudTest/Promptly-cloud-v0.6.8.3-fullstack/logs/auto-sync-stdout.log</string>
    
    <!-- 错误输出日志 -->
    <key>StandardErrorPath</key>
    <string>/Users/yangming/Desktop/Github/Promptly-v0.6-CloudTest/Promptly-cloud-v0.6.8.3-fullstack/logs/auto-sync-stderr.log</string>
    
    <!-- 允许在电池模式下运行 -->
    <key>LowPriorityIO</key>
    <true/>
    
    <!-- 最多同时运行一个实例 -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
