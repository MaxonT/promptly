{
  "manifest_version": 3,
  "name": "Promptly",
  "version": "0.1.0",
  "description": "Optimize messy prompts into agent-ready instructions using Promptly's pipeline.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://promptly.solutions/*",
    "https://www.promptly.solutions/*",
    "https://promptly-v0-6-cloudtest-1.onrender.com/*",
    "https://promptly-v0-6-cloudtest-cursor-dev.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Promptly",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://promptly.solutions/*",
        "https://www.promptly.solutions/*",
        "https://promptly-v0-6-cloudtest-1.onrender.com/*",
        "https://promptly-v0-6-cloudtest-cursor-dev.onrender.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
