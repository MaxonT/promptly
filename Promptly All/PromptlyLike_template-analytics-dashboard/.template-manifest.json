    "node": ">=16.0.0",
    "python": ">=3.8",
    "dependencies": {
      "backend": [
        "express",
        "better-sqlite3"
      ],
      "frontend": [
        "chart.js@4.4.1",
        "particles.js (CDN)"
      ],
      "simulator": [
        "requests"
      ]
    }
  },
  "quickStart": [
    "1. Copy template to your project",
