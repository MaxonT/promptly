  "features": {
    "ui": [
      "Glassmorphism design",
      "Particle.js animated background",
      "Responsive grid layout",
      "Dark/light mode",
      "Chart.js visualizations"
    ],
    "analytics": [
      "User tracking",
      "Session management",
      "Behavior events",
      "S-curve growth modeling",
      "Daily aggregations"
    ],
    "api": [
      "Summary endpoint",
      "Timeseries data",
      "Growth analysis",
      "User tracking",
      "Admin data generation"
    ],
    "database": [
      "analytics_users",
      "analytics_sessions",
      "analytics_behavior",
      "analytics_daily"
    ]
