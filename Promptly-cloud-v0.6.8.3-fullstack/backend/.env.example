# ============================================
# Promptly Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# --------------------------------------------
# Application Settings
# --------------------------------------------

# Node environment (development, production, test)
NODE_ENV=development

# Server port (default: 8080)
PORT=8080

# --------------------------------------------
# Database
# --------------------------------------------

# SQLite database path (for local development)
SQLITE_PATH=./data/app.db

# PostgreSQL database URL (for production on Render)
# Only needed if migrating from SQLite to Postgres
# DATABASE_URL=postgres://user:password@host:5432/promptly

# --------------------------------------------
# Authentication & Security
# --------------------------------------------

# JWT secret for token signing (REQUIRED in production)
# 🔒 SECURITY: Generate a long random string: openssl rand -base64 32
# ⚠️ 警告: 请在生产环境中使用强密码，不要使用示例值!
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# JWT token expiration time (default: 7d)
JWT_EXPIRES_IN=7d

# --------------------------------------------
# CORS Configuration  
# --------------------------------------------

# 🔒 SECURITY: 指定确切的前端域名，避免使用通配符
# Allowed frontend origins (comma-separated for multiple origins)
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app  
# ⚠️ 警告: 不要在生产环境使用 "*"
CORS_ORIGIN=http://localhost:5173

# --------------------------------------------
# OpenAI Configuration
# --------------------------------------------

# OpenAI API key (REQUIRED for LLM features)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Default LLM model for question generation, spec creation, evaluation
OPENAI_MODEL=gpt-4.1-mini

# Alternative model name shown in settings (optional)
OPENAI_DEFAULT_MODEL=gpt-4.1-mini

# --------------------------------------------
# Groq Configuration (Stage 0 + Stage 0.5 Gates)
# --------------------------------------------

# Groq API key — REQUIRED for Input Validation (Stage 0) and Ambiguity Detection (Stage 0.5)
# These lightweight gates use llama-3.1-8b-instant via Groq for speed & low cost.
# Get your key from: https://console.groq.com/keys
# ⚠️  If not set: both gates fail-open and the pipeline runs WITHOUT validation
GROQ_API_KEY=gsk_your-groq-api-key-here

# Optional: custom Groq base URL (leave blank to use default api.groq.com)
# GROQ_BASE_URL=

# Model for outcome runner (optional, falls back to OPENAI_MODEL)
OUTCOME_MODEL=gpt-4o-mini

# Maximum candidates for outcome runner (optional, default: 8)
MAX_CANDIDATES=8

# --------------------------------------------
# Share Links
# --------------------------------------------

# Base URL for share links (include trailing slash)
# Local: http://localhost:8080/share/
# Production: https://your-backend.onrender.com/share/
LINK_BASE=http://localhost:8080/share/

# --------------------------------------------
# Stripe Configuration (for Subscriptions)
# --------------------------------------------

# Stripe API keys
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhook secret
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs for subscription plans
# Create these in Stripe Dashboard > Products
STRIPE_PRICE_MONTHLY=price_monthly_9usd
STRIPE_PRICE_YEARLY=price_yearly_84usd

# Stripe mode (test/live)
STRIPE_MODE=test

# --------------------------------------------
# Subscription Configuration
# --------------------------------------------

# Pricing
MONTHLY_PRICE_USD=9
YEARLY_PRICE_USD=84

# Trial settings
TRIAL_DAYS=14
TRIAL_BASE_TOKENS=200000
TRIAL_DAILY_TOKENS=20000

# Token allocations
MONTHLY_PLAN_TOKENS=1000000
YEARLY_PLAN_TOKENS=12000000
PAID_DAILY_TOKENS=50000
DAILY_CARRY_CAP_TOKENS=40000

# Multiplier (default 1.0)
PLAN_MULTIPLIER=1.0

# Daily refresh hour (UTC, 0-23)
DAILY_REFRESH_HOUR_UTC=0

# Feature flags
SUBSCRIPTIONS_ENABLED=true
TRIALS_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=true
SHOW_TOKEN_BREAKDOWN=true
ENFORCE_TOKEN_LIMITS=true

# Anti-abuse settings
MAX_REGISTRATIONS_PER_IP_DAY=3
MAX_TRIALS_PER_IP_MONTH=2
RISK_THRESHOLD_REQUIRE_PAYMENT=70

# Frontend URL (for Stripe redirects) — single domain, legacy fallback
FRONTEND_URL=http://localhost:5173

# Multi-domain allowlist for OAuth redirects (comma-separated, no trailing slashes)
# When set, FRONTEND_URLS is used instead of FRONTEND_URL for OAuth post-login redirects.
# The backend captures the Origin header at OAuth initiate time, validates it against this
# list, and redirects back to the correct domain after login — preventing open-redirect attacks.
# Example (production):
# FRONTEND_URLS=https://promptly.solutions,https://promptly-v0-6-cloudtest-1.onrender.com
FRONTEND_URLS=http://localhost:5173

# Optional explicit redirect URLs (override FRONTEND_URL-based defaults)
# SUCCESS_URL=http://localhost:5173/checkout-success.html
# CANCEL_URL=http://localhost:5173/checkout-cancel.html
# ACCOUNT_URL=http://localhost:5173/account.html
