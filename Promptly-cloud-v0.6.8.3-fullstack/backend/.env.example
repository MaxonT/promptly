# Copy to backend/.env. Shell/deployment values take precedence.
NODE_ENV=development
PORT=8080
# Generate your own: openssl rand -hex 32
JWT_SECRET=
SQLITE_PATH=./data/app.db
CORS_ORIGIN=http://localhost:4173,http://127.0.0.1:4173
FRONTEND_URL=http://localhost:4173
FRONTEND_URLS=http://localhost:4173,http://127.0.0.1:4173
LINK_BASE=http://localhost:4173/share/
# Current main pipeline (all modes) uses Anthropic single-pass optimization.
ANTHROPIC_API_KEY=
# Optional Groq-backed wizard/legacy multi-stage flows.
GROQ_API_KEY=
# Optional legacy/standalone OpenAI routes, not required by the current main pipeline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
# Local self-host defaults: no payment/OAuth setup needed.
SUBSCRIPTIONS_ENABLED=false
TRIALS_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
ENFORCE_TOKEN_LIMITS=false
SHOW_TOKEN_BREAKDOWN=true
# Optional PostgreSQL (production support varies by route; see README).
# DATABASE_URL=postgresql://user:password@localhost:5432/promptly
# Optional OAuth (email/password works without these).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional billing; enable only after configuring your own Stripe account.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_YEARLY=
