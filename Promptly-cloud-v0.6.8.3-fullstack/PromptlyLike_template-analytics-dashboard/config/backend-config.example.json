{
  "// 说明": "Analytics Dashboard 后端配置示例",
  "// 用法": "复制为 config.json 并根据需要修改",
  
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "corsOrigin": "*"
  },
  
  "database": {
    "path": "./data/analytics.db",
    "journalMode": "WAL"
  },
  
  "analytics": {
    "goals": {
      "totalUsers": 5000,
      "dailyActiveUsers": 500
    },
    
    "sCurve": {
      "targetUsers": 2000,
      "growthRate": 0.08,
      "inflectionPoint": 40
    },
    
    "retention": {
      "trackSessionDuration": true,
      "trackPageViews": true,
      "trackBehavior": true
    }
  },
  
  "security": {
    "adminApiKey": "",
    "jwtSecret": "",
    "enableRateLimiting": true,
    "rateLimit": {
      "windowMs": 60000,
      "maxRequests": 100
    }
  },
  
  "logging": {
    "level": "info",
    "format": "json",
    "includeTimestamp": true
  }
}
